NODE_ENV=development
PORT=5000
# Add your frontend origin(s), e.g. http://localhost:5173 or https://your-frontend.vercel.app
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://school-management-app-lac.vercel.app
SCHOOL_NAME=Gurugram Public School
SCHOOL_SHORT_NAME=GPS

DB_USER=root
DB_PASSWORD=your_railway_mysql_password
DB_HOST=your_railway_mysql_host
DB_DATABASE=school_management
DB_PORT=3306
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_AUTO_INITIALIZE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=30000

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

ADMIN_NAME=GPS Admin
ADMIN_EMAIL=gurugarampublic.co.in@outlook.com
ADMIN_PASSWORD=change_this_admin_password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Gurugram Public School <gurugarampublic.co.in@outlook.com>
CONTACT_TO_EMAIL=gurugarampublic.co.in@outlook.com

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
